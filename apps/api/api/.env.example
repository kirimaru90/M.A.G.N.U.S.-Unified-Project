# MongoDB connection string (standalone instance is fine)
MONGO_URL=mongodb://localhost:27017/robco

# JWT signing secret — rotate this to invalidate all active sessions
JWT_SECRET=change-me-in-production

# Port the API listens on
PORT=3000

# Comma-separated list of allowed CORS origins. Empty by default: the apps reach the
# API same-origin through the edge proxy (/api), so no cross-origin allow-list is needed.
# Set this only if a future cross-origin client must call the API directly.
CORS_ALLOWED_ORIGINS=

# Bootstrap admin credentials (used only by the bootstrap:admin script)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
